# Mẫu cấu hình. Cách dùng:
#   cp .env.example .env.local     (rồi điền giá trị thật vào .env.local)
# .env.local đã nằm trong .gitignore – KHÔNG đẩy lên GitHub, KHÔNG dán vào chat.
# Trên Vercel: Settings → Environment Variables, thêm đúng các tên này, bật "Sensitive".
# KHÔNG đổi tên thành NEXT_PUBLIC_... (sẽ bị gửi xuống trình duyệt).

# mock = dữ liệu giả lập | rest = gọi API Nature Tourist
TOUR_PROVIDER=mock

# Địa chỉ server_api (Test hoặc Production) theo tài liệu Nature Tourist, ví dụ: https://api.example.com
TOUR_API_BASE_URL=

# user_key do Nature Tourist cấp, ví dụ: YOUR_API_KEY_HERE
TOUR_API_KEY=

# (Không bắt buộc) Gốc đường dẫn ảnh/file nếu API trả đường dẫn tương đối. Bỏ trống = dùng TOUR_API_BASE_URL
TOUR_ASSET_BASE_URL=

# (Không bắt buộc) Thời gian chờ API, mili giây. Mặc định 8000
TOUR_API_TIMEOUT_MS=
